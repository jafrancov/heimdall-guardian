<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.shop">

    <application android:label="Tienda">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.SettingsActivity" android:exported="false" />

        <service
            android:name=".sync.SyncService"
            android:exported="false" />

        <service
            android:name=".sync.PartnerService"
            android:permission="com.example.shop.permission.PARTNER"
            android:exported="true" />

        <receiver
            android:name=".sync.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.shop.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
